# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# local agent guidance — not for the public repo
/CLAUDE.md

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.factory
# pi-web uploads (runtime-generated file uploads)
/uploads/

# desktop build output (electron-builder) — large, regenerated by `npm run desktop:build`
/dist-electron/

# shipped Node runtime — 80MB binary, fetched on demand by desktop/fetch-node.cjs
/desktop/node-runtime/node.exe

# desktop icon source assets are large/optional; keep the built icon.ico though
/desktop/icon-build/
