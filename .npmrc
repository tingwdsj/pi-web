# Electron & electron-builder download mirrors (China-friendly).
# These tools fetch large prebuilt binaries from GitHub by default, which is
# slow/unreliable in China. Point them at the npmmirror CDN instead.
# Safe to delete if you are outside China or have reliable GitHub access.
electron_mirror=https://registry.npmmirror.com/-/binary/electron/
electron_builder_binaries_mirror=https://registry.npmmirror.com/-/binary/electron-builder-binaries/

# package-lock.json pins some tarballs to registry.npmmirror.com while the
# configured registry is registry.npmjs.org. npm 12 classifies a resolved URL
# whose host differs from the registry as a "remote" spec and refuses it
# (EALLOWREMOTE: 'Fetching packages of type "remote" have been disabled').
# Rewriting resolved hosts to the configured registry turns those back into
# normal registry fetches. Harmless when all URLs already match the registry.
replace-registry-host=always
