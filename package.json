{
  "name": "@tingwdsj/pi-web",
  "version": "0.8.0",
  "description": "Web UI for the pi coding agent",
  "homepage": "https://github.com/agegr/pi-web#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agegr/pi-web.git"
  },
  "bugs": {
    "url": "https://github.com/agegr/pi-web/issues"
  },
  "license": "MIT",
  "main": "main.cjs",
  "bin": {
    "pi-web": "bin/pi-web.js"
  },
  "files": [
    "bin",
    "public",
    "next.config.ts",
    "package.json",
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/*.js",
    ".next/server",
    ".next/static",
    "!.next/**/*.js.map",
    "!.next/**/*.nft.json"
  ],
  "scripts": {
    "dev": "next dev -p 30141",
    "build": "next build --webpack",
    "start": "next start -p 30141",
    "lint": "eslint .",
    "release": "npm version patch --no-git-tag-version && npm run build && npm publish --access public",
    "desktop:icon": "node desktop/make-icon.mjs",
    "desktop:dev": "cross-env PI_DESKTOP_DEV=1 electron desktop/main.cjs",
    "desktop:build:next": "cross-env NODE_OPTIONS=\"--require ./desktop/win-eperm-patch.cjs\" next build --webpack",
    "desktop:fetch-node": "node desktop/fetch-node.cjs",
    "desktop:build": "node desktop/fetch-node.cjs && npm run desktop:build:next && node desktop/ensure-standalone-chunks.cjs && electron-builder --config desktop/electron-builder.yml"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^0.80.3",
    "@earendil-works/pi-coding-agent": "^0.80.3",
    "@lobehub/icons": "^5.6.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "adm-zip": "^0.5.18",
    "katex": "^0.16.47",
    "mammoth": "^1.12.0",
    "mermaid": "^11.14.0",
    "next": "16.2.9",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5"
  }
}
